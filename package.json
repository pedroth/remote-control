{
  "name": "remote-control",
  "version": "0.0.15",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run ./server.mjs",
    "pub": "bun pm version patch; git push origin $(git describe --tags `git rev-list --tags --max-count=1`)",
    "build-windows": "bun build --compile --target=bun-windows-x64 ./server.mjs --outfile remote-control-server.exe",
    "build-linux": "bun build --compile --target=bun-linux-x64 ./server.mjs --outfile remote-control-server",
    "build-macos": "bun build --compile --target=bun-macos-x64 ./server.mjs --outfile remote-control-server"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@jitsi/robotjs": "^0.6.24",
    "express": "^4.22.2",
    "ip": "^1.1.9",
    "open": "^9.1.0",
    "ws": "^8.21.3"
  }
}